  "fixed_sql": [
    {
      "name": "attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attempts\" (\"id\" TEXT NOT NULL, \"passage_id\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"overall\" INTEGER NOT NULL, \"accuracy\" INTEGER NOT NULL, \"fluency\" INTEGER NOT NULL, \"audio_path\" TEXT NULL, \"tier\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "word_results",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"word_results\" (\"attempt_id\" TEXT NOT NULL REFERENCES attempts (id) ON DELETE CASCADE, \"words\" BLOB NOT NULL, PRIMARY KEY (\"attempt_id\"));"
        }
      ]
    },
    {
      "name": "sound_stats",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sound_stats\" (\"ipa\" TEXT NOT NULL, \"accuracy\" REAL NOT NULL, \"attempts\" INTEGER NOT NULL, \"last_practised\" INTEGER NOT NULL, PRIMARY KEY (\"ipa\"));"
        }
      ]
    },
    {
      "name": "review_queue",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_queue\" (\"word_key\" TEXT NOT NULL, \"word\" TEXT NOT NULL, \"phonemes\" TEXT NOT NULL, \"due\" INTEGER NOT NULL, \"interval_days\" INTEGER NOT NULL, \"ease\" REAL NOT NULL, \"stage\" INTEGER NOT NULL, \"last_score\" INTEGER NULL, \"passage_id\" TEXT NULL, PRIMARY KEY (\"word_key\"));"
        }
      ]
    },
    {
      "name": "user_profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_profile\" (\"id\" INTEGER NOT NULL, \"level\" INTEGER NOT NULL, \"daily_goal_minutes\" INTEGER NOT NULL, \"streak\" INTEGER NOT NULL, \"last_practice\" INTEGER NULL, \"keep_recordings\" INTEGER NOT NULL CHECK (\"keep_recordings\" IN (0, 1)), \"placement_done\" INTEGER NOT NULL CHECK (\"placement_done\" IN (0, 1)), \"placement_level\" INTEGER NULL, \"reminder_minutes\" INTEGER NULL, \"text_scale\" REAL NOT NULL, \"tier_override\" TEXT NULL, \"onboarding_done\" INTEGER NOT NULL CHECK (\"onboarding_done\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "level_changes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"level_changes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"from_level\" INTEGER NOT NULL, \"to_level\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "practice_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"practice_sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"start\" INTEGER NOT NULL, \"duration_us\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "attempts_at",
