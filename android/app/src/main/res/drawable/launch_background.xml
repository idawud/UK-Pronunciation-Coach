<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen before Flutter's first frame (Android 10 and 11; Android 12+ uses
     the windowSplashScreen* attributes in values-v31). Navy background with the app
     icon's speech bubble, from tools/release/icons.py. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
